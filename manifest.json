{
  "manifest_version": 3,
  "name": "TeleVault",
  "short_name": "TeleVault",
  "version": "3.1.0",
  "description": "Save media from Telegram Web chats and channels into organized folders. Not affiliated with Telegram.",
  "author": "Adham Idiboyev (@SuperMix)",
  "homepage_url": "https://github.com/idiboyev/TeleVault",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "notifications"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "TeleVault — sozlamalar",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": ["defaults.js", "bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": [
        "defaults.js",
        "settings.js",
        "utils.js",
        "downloader.js",
        "ui.js",
        "observer.js",
        "scanner.js",
        "archive.js",
        "panel.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
